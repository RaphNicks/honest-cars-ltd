# ============================================================================
# Honest Cars LTD — environment template.
# Copy to .env and point at YOUR MySQL instance (`cp .env.example .env`).
# Every value has a safe default in src/config.js, so an empty .env still runs.
# ============================================================================

NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Public origin — canonical URLs, sitemap, OG tags, JSON-LD @id
SITE_URL=http://localhost:3000

# Staff console origin. In production set https://admin.honestcarsltd.com and
# point that DNS name + TLS certificate at this app. /admin on the public host
# redirects here. Leave empty locally to derive admin.localhost:3000.
ADMIN_URL=

# --- MySQL / MariaDB --------------------------------------------------------
# Local laptop default:
#   DB_HOST=127.0.0.1  DB_PORT=3306  DB_USER=root  DB_PASSWORD=yourpassword
# Sandbox default (bundled MySQL 5.7):
#   DB_HOST=127.0.0.1  DB_PORT=3307  DB_USER=honestcars  DB_PASSWORD=honestcars
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=honestcars
DB_PASSWORD=honestcars
DB_NAME=honestcars
# Optional unix socket; when set it takes priority over host/port.
# DB_SOCKET=/var/run/mysqld/mysqld.sock
# `npm run db:setup` creates the database, so it needs an account that may do
# that. When DB_USER is root these are not needed. With the Docker MySQL from
# docker-compose.yml the values are:
#   DB_ADMIN_USER=root
#   DB_ADMIN_PASSWORD=honestcars-root
DB_ADMIN_USER=
DB_ADMIN_PASSWORD=
DB_POOL_SIZE=10

# --- Business facts (copy/schema) ------------------------------------------
BUSINESS_PHONE=+2349135626182
BUSINESS_WHATSAPP=2349135626182
BUSINESS_EMAIL=hello@honestcarsltd.com
BUSINESS_LAT=4.8156
BUSINESS_LNG=7.0498

# --- Sold-archive rule (PRD §6.2 / §14.1) ----------------------------------
SOLD_VISIBLE_DAYS=7
SOLD_REDIRECT_DAYS=90

# --- Listings ---------------------------------------------------------------
LISTINGS_PER_PAGE=24
HOME_FEED_LIMIT=8

# --- Analytics (§15) --------------------------------------------------------
GA4_ID=
META_PIXEL_ID=
ANALYTICS_SERVER_SIDE=true

# --- Customer accounts / OTP (PRD §7.1, §12.2) ------------------------------
# Customers use email OTP or Google. Phone OTP is only for staff and dealer
# sign-in (/login on ADMIN_URL, /dealer/login on the public host); staff also use TOTP.
# Console delivery is development-only. SMS/WhatsApp adapters must be implemented
# and configured before production phone sign-in can be used.
AUTH_OTP_PROVIDER=console
AUTH_OTP_TTL_MINUTES=10
AUTH_OTP_LENGTH=6
AUTH_MAX_VERIFY_ATTEMPTS=5
AUTH_MAX_REQUESTS_PER_HOUR=5
AUTH_EMAIL_MAX_REQUESTS_PER_HOUR=5
AUTH_SESSION_DAYS=30
# REQUIRED in production: peppers phone/email OTP hashes, OAuth state and sessions.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_PEPPER=
# Development only: return OTP in API responses; always off in production.
AUTH_SHOW_CODE=true
# Generic SMTP for customer email verification/sign-in codes.
SMTP_URL=
SMTP_FROM=Honest Cars <hello@honestcarsltd.com>
# Google OAuth client; callback is /api/auth/google/callback on your public SITE_URL.
# Register the exact callback URI in Google Cloud and set production credentials in hosting.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# --- Payments (PRD §7.3 "Orders & Payments", §12.2) --------------------------
# Default provider when a customer checks out. With no PSP keys set the site
# takes bank transfers and cash and records them in the console; hosted
# checkout refuses honestly rather than pretending to redirect.
PAYMENT_PROVIDER=manual
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
# Flutterwave's webhook hash (Dashboard → Settings → Webhooks).
FLUTTERWAVE_SECRET_HASH=
# The account customers transfer to while no card processor is live.
BUSINESS_BANK_NAME=GTBank
BUSINESS_BANK_ACCOUNT=0123456789
BUSINESS_BANK_ACCOUNT_NAME=Honest Cars Ltd

# --- Settings the console can override (§5.1) --------------------------------
# Several values below — the business facts, the page limits, the sold-car
# windows, the concierge SLA card, the referral and CAC figures, and the channel
# each message takes — are also editable at /admin/settings, where an override
# wins over the value here and "Reset to defaults" comes back to it. A setting
# with no row in the `settings` table is exactly what this file says.
#
# Deployment credentials are NOT settings and are never on that screen. Set them
# in the local .env or hosting environment; never commit real credential values.

# --- Notifications (PRD §11) -------------------------------------------------
# Channel used by every template, with a payment-specific override: whatsapp |
# sms | email | console. `console` prints the message and records it as sent —
# the development default. A channel with no provider configured records the
# message as `skipped` (readable at /admin/payments), never silently dropped.
NOTIFY_CHANNEL=console
NOTIFY_CHANNEL_PAYMENT=console
# FR-34 — the financing referral and its updates. Left empty they follow the
# general channel; a lender referral delivered nowhere is recorded `skipped`,
# never reported to the desk as sent.
NOTIFY_CHANNEL_FINANCING=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
SMS_API_KEY=

# --- Marketing (§15.2) ------------------------------------------------------
# A channel whose cost per paid transaction sits above this is flagged on
# /admin/marketing. Kobo, so the maths never touches a float.
MARKETING_CAC_GUARDRAIL_KOBO=3500000

# --- Referrals (FR-28) ------------------------------------------------------
# The suggested reward, in kobo — the console pre-fills it and the desk can
# override it per referral. How many paid orders make a referral count.
REFERRAL_REWARD_KOBO=200000
REFERRAL_QUALIFY_ORDERS=1

# --- Rendering --------------------------------------------------------------
SERVE_STATIC_PAGES=true
STATIC_DIR=dist
