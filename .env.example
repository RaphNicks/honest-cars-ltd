# ============================================================================
# Honest Cars LTD — environment template.
# Copy to .env and point at YOUR MySQL instance (`cp .env.example .env`).
# Every value has a safe default in src/config.js, so an empty .env still runs.
# ============================================================================

NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Public origin — canonical URLs, sitemap, OG tags, JSON-LD @id
SITE_URL=http://localhost:3000

# --- MySQL / MariaDB --------------------------------------------------------
# Local laptop default:
#   DB_HOST=127.0.0.1  DB_PORT=3306  DB_USER=root  DB_PASSWORD=yourpassword
# Sandbox default (bundled MySQL 5.7):
#   DB_HOST=127.0.0.1  DB_PORT=3307  DB_USER=honestcars  DB_PASSWORD=honestcars
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=honestcars
DB_PASSWORD=honestcars
DB_NAME=honestcars
# Optional unix socket; when set it takes priority over host/port.
# DB_SOCKET=/var/run/mysqld/mysqld.sock
DB_POOL_SIZE=10

# --- Business facts (copy/schema) ------------------------------------------
BUSINESS_PHONE=+2348000000000
BUSINESS_WHATSAPP=2348000000000
BUSINESS_EMAIL=hello@honestcarsltd.com
BUSINESS_LAT=4.8156
BUSINESS_LNG=7.0498

# --- Sold-archive rule (PRD §6.2 / §14.1) ----------------------------------
SOLD_VISIBLE_DAYS=7
SOLD_REDIRECT_DAYS=90

# --- Listings ---------------------------------------------------------------
LISTINGS_PER_PAGE=24
HOME_FEED_LIMIT=8

# --- Analytics (§15) --------------------------------------------------------
GA4_ID=
META_PIXEL_ID=
ANALYTICS_SERVER_SIDE=true

# --- Rendering --------------------------------------------------------------
SERVE_STATIC_PAGES=true
STATIC_DIR=dist
