{
  "name": "honest-cars-ltd",
  "version": "1.0.0",
  "private": true,
  "description": "honestcarsltd.com \u2014 vanilla HTML/CSS/JS storefront on Node.js + Express + EJS + MySQL",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:setup": "node scripts/db-setup.js",
    "db:migrate": "node scripts/migrate.js",
    "db:seed": "node scripts/generate-seed.js && node scripts/db-setup.js",
    "build:static": "node scripts/build-static.js",
    "check-links": "node scripts/check-links.js",
    "crawl": "node scripts/crawl.mjs",
    "audit:pages": "node scripts/audit-pages.mjs",
    "images": "node scripts/prepare-images.js",
    "images:check": "node scripts/prepare-images.js --check",
    "lint:type": "node scripts/lint-type-scale.js",
    "lint:js": "node scripts/lint-js.js",
    "lint": "npm run lint:type && npm run lint:js",
    "test": "node --test test/*.test.js",
    "artifacts": "node scripts/build-static.js && node scripts/lint-type-scale.js",
    "check": "npm run lint && npm test",
    "smoke": "node scripts/smoke-roles.mjs",
    "smoke:cms": "node scripts/cms-smoke.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "compression": "^1.7.4",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "mysql2": "^3.11.3",
    "pdfkit": "^0.20.2",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.3.0",
    "typeface-inter": "^3.18.1"
  }
}
