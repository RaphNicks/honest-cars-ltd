<%
  /**
   * /account/renewals/:reference — paying for a subscription renewal (§7.3).
   *
   * The same honest shape as /order/:orderNo: while no PSP keys exist, the
   * customer gets the bank account and the reference to pay against, and the
   * page says plainly that nothing was charged and that the renewal date does
   * not move until the money lands.
   *
   * Locals: payment, subscription, bank, trail
   */
%>
<section class="page-hero page-hero--account">
  <div class="container">
    <%- include('../partials/breadcrumbs', { crumbs: trail }) %>
    <p class="eyebrow">Subscription renewal</p>
    <h1>Renew <%= subscription && subscription.unitLabel ? subscription.unitLabel : 'your subscription' %></h1>
    <p class="lead mb-0">
      <%= helpers.formatNaira(payment.amountKobo) %> for
      <%= payment.purpose === 'subscription' ? 'the next period' : payment.purpose %>.
      Status: <strong><%= payment.status.replace(/_/g, ' ') %></strong>.
    </p>
  </div>
</section>

<section class="section">
  <div class="container container--narrow">
    <% if (payment.status === 'paid') { %>
      <div class="panel panel--paid">
        <h2 class="panel__title">Paid — you are covered for another year</h2>
        <p class="mb-0">
          <%= helpers.formatNaira(payment.amountKobo) %> received against
          <span class="tabular"><%= payment.reference %></span>.
          <% if (subscription && subscription.renewalAt) { %>
            Your next renewal is
            <strong><%= new Date(subscription.renewalAt).toLocaleDateString('en-NG', { day: 'numeric', month: 'long', year: 'numeric' }) %></strong>.
          <% } %>
          The receipt is in your account, and the device stays on the platform without interruption.
        </p>
      </div>
    <% } else if (payment.refundKobo) { %>
      <div class="panel">
        <h2 class="panel__title">Refunded</h2>
        <p class="mb-0">
          <%= helpers.formatNaira(payment.refundKobo) %> went back against
          <span class="tabular"><%= payment.reference %></span><%= payment.refundReason ? ` — ${payment.refundReason}` : '' %>.
        </p>
      </div>
    <% } else { %>
      <div class="panel panel--pay">
        <h2 class="panel__title">How to pay <%= helpers.formatNaira(payment.amountKobo) %></h2>
        <p class="mb-2">
          Transfer to the account below and use the payment reference as the narration. Your subscription renews the
          moment the money lands — nothing was charged on this page, and the renewal date does not move until it does.
        </p>
        <dl class="summary-list">
          <div class="summary-list__row"><dt>Account name</dt><dd><%= bank.name %></dd></div>
          <div class="summary-list__row"><dt>Bank</dt><dd><%= bank.bank %></dd></div>
          <div class="summary-list__row"><dt>Account number</dt><dd class="tabular"><strong><%= bank.account %></strong></dd></div>
          <div class="summary-list__row"><dt>Amount</dt><dd class="tabular"><strong><%= helpers.formatNaira(payment.amountKobo) %></strong></dd></div>
          <div class="summary-list__row"><dt>Payment reference</dt><dd class="tabular"><strong><%= payment.reference %></strong></dd></div>
        </dl>
        <p class="field__hint mb-0"><%= bank.note %></p>
      </div>
    <% } %>

    <% if (subscription) { %>
      <div class="panel mt-3">
        <h2 class="panel__title">What this covers</h2>
        <dl class="summary-list">
          <div class="summary-list__row"><dt>Plan</dt><dd><%= subscription.planName || subscription.kindLabel %></dd></div>
          <% if (subscription.unitLabel) { %>
            <div class="summary-list__row"><dt>Unit</dt><dd><%= subscription.unitLabel %></dd></div>
          <% } %>
          <div class="summary-list__row"><dt>Period</dt><dd><%= subscription.periodMonths %> months</dd></div>
          <% if (subscription.renewalAt) { %>
            <div class="summary-list__row">
              <dt>Renews</dt>
              <dd><%= new Date(subscription.renewalAt).toLocaleDateString('en-NG', { day: 'numeric', month: 'long', year: 'numeric' }) %></dd>
            </div>
          <% } %>
        </dl>
        <p class="field__hint mb-0">
          <% if (payment.status === 'paid') { %>
            Renewing early never costs you days — the period is added to the date above rather than replacing it.
          <% } else { %>
            If this unit is off the road or the car has been sold, message us before paying — a subscription you no longer
            need is not a subscription you should renew.
          <% } %>
        </p>
      </div>
    <% } %>

    <p class="mt-3 mb-0">
      <a class="btn btn--secondary" href="/account#subscriptions">Back to my account</a>
    </p>
  </div>
</section>
