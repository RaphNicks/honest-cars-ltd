<%#
  /admin/cms/faqs — question and answer content (§7.3), scoped to the pages that
  show it. Answers feed FAQPage schema on those pages (§14.2).
  Locals: faqs, scopes, scopeOptions
%>
<div class="admin-head">
  <h1>FAQs</h1>
  <p class="admin-head__lead">
    <%= faqs.length %> questions, <%= faqs.filter(function (f) { return f.isActive; }).length %> switched on.
    Scope decides where a question appears — <code>global</code> is the homepage and /faq.
  </p>
</div>

<section class="panel">
  <h2 class="panel__title">Add a question</h2>
  <form method="post" action="/admin/cms/faqs" class="admin-grid admin-grid--2">
    <div class="field">
      <label class="field__label" for="n-scope">Scope</label>
      <input class="input" id="n-scope" name="scope" type="text" list="scope-list" value="global" maxlength="80">
      <datalist id="scope-list">
        <% scopeOptions.forEach(function (scope) { %><option value="<%= scope %>"><% }); %>
        <% scopes.forEach(function (scope) { %><option value="<%= scope %>"><% }); %>
      </datalist>
    </div>
    <div class="field">
      <label class="field__label" for="n-position">Position</label>
      <input class="input" id="n-position" name="position" type="number" min="0" max="999" value="<%= faqs.length + 1 %>">
    </div>
    <div class="field">
      <label class="field__label" for="n-question">Question</label>
      <input class="input" id="n-question" name="question" type="text" maxlength="300" required>
    </div>
    <div class="field">
      <label class="field__label" for="n-answer">Answer</label>
      <textarea class="input" id="n-answer" name="answer" rows="2" maxlength="2000" required></textarea>
    </div>
    <div class="field">
      <label class="cms-check"><input type="checkbox" name="is_active" value="1" checked> Show this question</label>
    </div>
    <div class="field" style="align-self: end;">
      <button class="btn btn--primary" type="submit">Add FAQ</button>
    </div>
  </form>
</section>

<section class="panel" style="margin-top: var(--space-3);">
  <h2 class="panel__title">All questions</h2>
  <table class="table table--stack">
    <thead>
      <tr>
        <th scope="col">Question</th>
        <th scope="col">Scope</th>
        <th scope="col">Position</th>
        <th scope="col">Live</th>
        <th scope="col"></th>
      </tr>
    </thead>
    <tbody>
      <% faqs.forEach(function (faq) { %>
        <tr>
          <th scope="row">
            <form method="post" action="/admin/cms/faqs/<%= faq.id %>" id="faq-<%= faq.id %>">
              <input class="input" name="question" type="text" maxlength="300" value="<%= faq.question %>">
              <textarea class="input" name="answer" rows="2" maxlength="2000" style="margin-top: 4px;"><%= faq.answer %></textarea>
            </form>
          </th>
          <td>
            <input class="input" name="scope" form="faq-<%= faq.id %>" type="text" value="<%= faq.scope %>" maxlength="80">
          </td>
          <td>
            <input class="input tabular" name="position" form="faq-<%= faq.id %>" type="number" min="0" max="999" value="<%= faq.position %>" style="max-width: 90px;">
          </td>
          <td>
            <label class="cms-check">
              <input type="checkbox" name="is_active" value="1" form="faq-<%= faq.id %>" <%= faq.isActive ? 'checked' : '' %>>
              <span class="visually-hidden">Live</span>
            </label>
          </td>
          <td>
            <div class="admin-actions__group">
              <button class="btn btn--secondary btn--sm" type="submit" form="faq-<%= faq.id %>">Save</button>
              <button class="btn btn--ghost btn--sm" type="submit" form="faq-<%= faq.id %>-delete">Delete</button>
            </div>
            <form method="post" action="/admin/cms/faqs/<%= faq.id %>/delete" id="faq-<%= faq.id %>-delete"
                  onsubmit="return confirm('Delete this FAQ? It disappears from every page that shows it.')"></form>
          </td>
        </tr>
      <% }); %>
    </tbody>
  </table>
</section>
