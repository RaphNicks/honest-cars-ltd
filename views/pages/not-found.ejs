    <h1>We can’t find that page</h1>
    <p>
      The link may be out of date or the page may have moved. Here are a few ways to keep going.
    </p>
    <div class="btn-row mt-2" style="justify-content:center">
      <a class="btn btn--primary" href="/cars">Browse cars in Port Harcourt</a>
      <a class="btn btn--secondary" href="/">Go to the homepage</a>
      <a class="btn btn--ghost" href="<%= site.nav.whatsapp.general %>" target="_blank" rel="noopener">Chat with us</a>
    </div>
  </div>
</section>
