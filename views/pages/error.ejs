<%# 403 / 500 — plain, honest, no stack traces (§12.2). %>
<section class="container section">
  <div class="empty-state">
    <% if (typeof reason !== 'undefined' && reason === 'forbidden') { %>
      <h1>This part of the console is not yours to open</h1>
      <p>
        You are signed in as <strong><%= role %></strong>. The operations console is gated by the
        role matrix (§7.4) — if you need a module, an admin can grant the role that holds it.
        Nothing has gone wrong and nothing was changed.
      </p>
      <div class="btn-row mt-2" style="justify-content:center">
        <a class="btn btn--primary" href="/account">Back to your account</a>
        <a class="btn btn--secondary" href="/">Back to the homepage</a>
      </div>
    <% } else { %>
      <h1>Something went wrong on our side</h1>
      <p>
        That is on us, not you. Nothing was charged and nothing was submitted twice — refresh to try
        again, or message us on WhatsApp and we will handle it manually.
      </p>
      <div class="btn-row mt-2" style="justify-content:center">
        <a class="btn btn--primary" href="/">Back to the homepage</a>
        <a class="btn btn--secondary" href="<%= site.nav.whatsapp.general %>" target="_blank" rel="noopener"
           data-event="whatsapp_click" data-source="error_page">Chat on WhatsApp</a>
      </div>
    <% } %>
  </div>
</section>
