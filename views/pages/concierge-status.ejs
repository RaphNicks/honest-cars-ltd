<%#
  Concierge status page — §6.5: /concierge/{id}: Searching → Options ready →
  Viewings → Closed stages, pushes WhatsApp updates at each stage.
  §7.3 shortlist: when ops have attached cars, they render here as cards plus the
  same comparison rows /cars/compare uses, with a PDF to forward.
  Private by design: noindex, not cached (the route sets both).
%>
<section class="page-hero">
  <div class="container">
    <%- include('../partials/breadcrumbs', { crumbs: trail }) %>
    <p class="eyebrow">Concierge request</p>
    <h1 class="mb-1">Your brief is with the team</h1>
    <p class="reference-big mb-2"><%= request.trackingId %></p>
    <p class="page-hero__meta">
      <span class="badge badge--verified"><%= request.statusLabel %></span>
      <span>Opened <%= helpers.relativeDays(request.createdAt) %></span>
      <% if (request.slaDueAt) { %>
        <span>SLA due <%= new Date(request.slaDueAt).toLocaleDateString('en-NG', { day: 'numeric', month: 'short' }) %></span>
      <% } %>
    </p>
  </div>
</section>

<% if (shortlist) { %>
<section class="section">
  <div class="container">
    <div class="section-head">
      <div>
        <p class="eyebrow">Your shortlist</p>
        <h2 class="mb-1"><%= shortlist.count %> verified <%= shortlist.count === 1 ? 'car' : 'cars' %> against your brief</h2>
        <p class="mb-0">Ranked by how well they fit. Every one has been through HonestCars — papers, mileage and condition checked before it reached you.</p>
      </div>
      <div class="btn-row">
        <a class="btn btn--secondary" href="<%= shortlistPdf %>">Download the PDF</a>
        <a class="btn btn--primary" href="<%= site.nav.whatsapp.general %>" target="_blank" rel="noopener"
           data-event="whatsapp_click" data-source="concierge_shortlist">Book a viewing</a>
      </div>
    </div>

    <ol class="shortlist">
      <% shortlist.cards.forEach(function (card) { %>
        <li class="shortlist__item">
          <article class="card card__body shortlist__card">
            <div class="shortlist__rank" aria-hidden="true"><%= card.rank %></div>
            <p class="mb-1">
              <a href="<%= card.listing.url %>"><strong><%= card.listing.title %></strong></a>
              <span class="badge badge--<%= card.listing.grade %>"><%= card.listing.gradeLabel %></span>
            </p>
            <p class="car-card__price mb-1"><%= helpers.formatNaira(card.listing.priceKobo) %></p>
            <p class="page-hero__meta mb-1">
              <span class="price-position price-position--<%= card.listing.pricePosition %>">
                <span class="price-position__dot" aria-hidden="true"></span>
                <%= card.listing.pricePositionLabel || 'No market band yet' %>
              </span>
              · <%= Number(card.listing.mileageKm || 0).toLocaleString('en-NG') %> km
              · <%= card.listing.area %>
            </p>
            <% if (card.note) { %>
              <p class="shortlist__note">“<%= card.note %>”</p>
            <% } %>
            <p class="mb-0 mt-2"><a class="btn btn--ghost btn--sm" href="<%= card.listing.url %>">See the full listing</a></p>
          </article>
        </li>
      <% }); %>
    </ol>

    <% if (shortlist.compared.length >= 2) { %>
      <h3 class="mt-3 mb-1">Side by side</h3>
      <div class="compare-wrap">
        <table class="compare-table">
          <caption class="visually-hidden">Comparison of the top <%= shortlist.compared.length %> cars on this shortlist</caption>
          <thead>
            <tr>
              <td class="compare-row-label">Car</td>
              <% shortlist.compared.forEach(function (listing) { %>
                <th scope="col">
                  <p class="mb-0"><a href="<%= listing.url %>"><%= listing.title %></a></p>
                  <p class="compare-card__price mb-0"><%= helpers.formatNaira(listing.priceKobo) %></p>
                </th>
              <% }); %>
            </tr>
          </thead>
          <tbody>
            <% shortlist.rows.forEach(function (row) { %>
              <tr>
                <th scope="row" class="compare-row-label"><%= row.label %></th>
                <% row.values.forEach(function (value, index) { %>
                  <td class="<%= row.bestIndex === index ? 'best-value' : '' %>">
                    <%= value %>
                    <% if (row.bestIndex === index) { %> <span aria-label="best value">✔</span><% } %>
                  </td>
                <% }); %>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
      <p class="field__hint">
        The comparison covers the top <%= shortlist.compared.length %>. Green marks the stronger number on that row — a fact, not a
        recommendation: <a href="/guide">what to check before you pay</a> still matters more than any single figure here.
      </p>
    <% } %>
  </div>
</section>
<% } %>

<section class="section">
  <div class="container">
    <div class="grid grid--2" style="align-items:start">
      <div>
        <h2>Where this is</h2>
        <ol class="timeline">
          <% stages.forEach(function (stage, index) { %>
            <%
              var state = index < request.stageIndex ? 'done' : index === request.stageIndex ? 'current' : 'todo';
            %>
            <li class="timeline__item" data-state="<%= state %>">
              <span class="timeline__dot" aria-hidden="true"></span>
              <p class="timeline__title mb-0">
                <%= stage.label %>
                <% if (state === 'done') { %><span class="timeline__meta">· done</span><% } %>
                <% if (state === 'current') { %><span class="timeline__meta">· where we are now</span><% } %>
              </p>
              <p class="timeline__body"><%= stage.blurb %></p>
            </li>
          <% }); %>
        </ol>
      </div>

      <aside class="stack">
        <div class="card card__body">
          <h2 class="mb-1">The brief we are working from</h2>
          <dl class="summary-list">
            <% Object.entries(request.brief || {}).forEach(function ([key, value]) { %>
              <% if (value === null || value === '' || (Array.isArray(value) && !value.length)) return; %>
              <div class="summary-list__row">
                <dt><%= key.replace(/_/g, ' ') %></dt>
                <dd><%= Array.isArray(value) ? value.join(', ') : value %></dd>
              </div>
            <% }); %>
          </dl>
          <p class="field__hint mb-0">Wrong on any line? Reply on WhatsApp and we update it before the search continues.</p>
        </div>

        <% if (retainer) { %>
          <div class="card card__body">
            <h2 class="mb-1">Your retainer</h2>
            <p class="reference-big mb-1"><%= helpers.formatNaira(retainer.amountKobo) %></p>
            <p class="mb-2">
              <span class="badge badge--<%= retainerState ? retainerState.tone : 'ghost' %>">
                <span class="badge__dot" aria-hidden="true"></span><%= retainerState ? retainerState.label : retainer.status %>
              </span>
            </p>
            <p class="mb-2"><%= retainerState ? retainerState.blurb : '' %></p>
            <dl class="summary-list">
              <div class="summary-list__row">
                <dt>Reference</dt>
                <dd><%= retainer.reference %></dd>
              </div>
              <div class="summary-list__row">
                <dt>Raised</dt>
                <dd><%= helpers.relativeDays(retainer.createdAt) %></dd>
              </div>
              <% if (retainer.refundKobo) { %>
                <div class="summary-list__row">
                  <dt>Refunded</dt>
                  <dd><%= helpers.formatNaira(retainer.refundKobo) %><%= retainer.refundReason ? ' — ' + retainer.refundReason : '' %></dd>
                </div>
              <% } %>
            </dl>
            <% if (retainer.status === 'pending' || retainer.status === 'failed' || retainer.status === 'abandoned') { %>
              <p class="field__hint mb-0">
                Pay by bank transfer quoting <strong><%= retainer.reference %></strong>, then reply on WhatsApp with the
                receipt. Ops confirms it by hand — and the search is already running.
              </p>
            <% } %>
          </div>
        <% } %>

        <div class="card card__body">
          <h2 class="mb-1">Talk to the team</h2>
          <p class="mb-2">Quote your tracking ID when you message — it saves you repeating the brief.</p>
          <a class="btn btn--primary btn--block" href="<%= site.nav.whatsapp.general %>" target="_blank" rel="noopener"
             data-event="whatsapp_click" data-source="concierge_status">Continue on WhatsApp</a>
        </div>

        <div class="card card__body">
          <h2 class="mb-1">While you wait</h2>
          <ul class="tick-list">
            <li class="tick-list__yes"><%- helpers.icon('check', { size: 16 }) %> <span><a href="/cars">Browse verified stock</a> — options may already be live.</span></li>
            <li class="tick-list__yes"><%- helpers.icon('check', { size: 16 }) %> <span><a href="/services/inspection">Book an inspection</a> on a car you found yourself.</span></li>
            <li class="tick-list__yes"><%- helpers.icon('check', { size: 16 }) %> <span><a href="/guide">Read the Honest Buyer’s Guide</a> — what to check before you pay.</span></li>
          </ul>
        </div>
      </aside>
    </div>
  </div>
</section>
