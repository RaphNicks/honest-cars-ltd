<%#
  Product page — §6.8: “photo(s), price, stock status, key specs, ‘installation
  included?’ toggle where relevant (tracker install = booking at checkout),
  warranty line, delivery options (pickup meet-point / PH delivery).”
%>
<section class="section">
  <div class="container">
    <%- include('../partials/breadcrumbs', { crumbs: trail }) %>

    <div class="product-detail">
      <div>
        <div class="product-detail__media">
          <% if (product.image) { %>
            <img src="<%= helpers.photoSrc(product.image) %>" alt="<%= helpers.esc(product.name) %> — product photo"
                 width="1200" height="900" fetchpriority="high" decoding="async">
          <% } %>
        </div>
        <p class="field__hint">Product photography is a placeholder in this build — real shots land with the phase-2 catalogue.</p>
      </div>

      <div>
        <span class="badge badge--ghost"><%= product.categoryLabel %></span>
        <h1 class="mt-1"><%= product.name %></h1>
        <p class="lead"><%= product.summary %></p>
        <p class="product-detail__price mb-1"><%= helpers.formatNaira(product.priceKobo) %></p>
        <p class="page-hero__meta">
          <span class="stock-pill stock-pill--<%= product.stockStatus %>">
            <%= product.stockStatus === 'in_stock' ? 'In stock' : product.stockStatus === 'low_stock' ? 'Low stock' : 'Out of stock' %>
          </span>
          <% if (product.installIncluded) { %>· <span><%- helpers.icon('cog', { size: 14 }) %> Installation included in PH</span><% } %>
        </p>

        <% if (product.stockStatus === 'out_of_stock') { %>
          <p class="legal-note">Out of stock right now — message us and we will tell you the honest restock date.</p>
        <% } else { %>
          <div class="btn-row mt-2">
            <button class="btn btn--primary btn--lg" type="button"
                    data-buy-now data-slug="<%= product.slug %>" data-name="<%= helpers.esc(product.name) %>"
                    data-price="<%= product.priceKobo %>" data-image="<%= product.image %>" data-category="<%= product.category %>">
              Buy now
            </button>
            <button class="btn btn--secondary btn--lg" type="button"
                    data-add-to-cart data-slug="<%= product.slug %>" data-name="<%= helpers.esc(product.name) %>"
                    data-price="<%= product.priceKobo %>" data-image="<%= product.image %>" data-category="<%= product.category %>"
                    data-install="<%= product.installIncluded ? 'yes' : 'no' %>" data-label="Add to cart">
              Add to cart
            </button>
          </div>
          <p class="field__hint">
            Cart is on your device until you checkout; prices are confirmed server-side when the order is placed.
          </p>
        <% } %>

        <% if (product.category === 'trackers' && product.installIncluded) { %>
          <label class="checkbox-row mt-2">
            <input type="checkbox" data-install-toggle checked>
            <span>Book the installation with my order — we call you to fix a slot within Port Harcourt.</span>
          </label>
          <p class="field__hint">
            Bought a tracker? It creates a subscription record automatically: device installed → platform
            activated → renewal date set a year out.
          </p>
        <% } %>

        <% if (product.warrantyText) { %>
          <p class="mt-2"><strong>Warranty:</strong> <%= product.warrantyText %></p>
        <% } %>

        <h2 class="mt-3">Delivery options</h2>
        <ul class="tick-list">
          <% (product.deliveryOptions || []).forEach(function (option) { %>
            <li class="tick-list__yes"><%- helpers.icon('check', { size: 16 }) %>
              <span>
                <%= option === 'pickup_meet_point' ? 'Pickup at a PH meet-point (Pleasant Stores, GRA)'
                    : option === 'ph_delivery' ? 'Delivery within Port Harcourt — fee by area at checkout'
                    : option === 'install_booking' ? 'Installation booked at your location (Port Harcourt)'
                    : option %>
              </span>
            </li>
          <% }); %>
        </ul>

        <% if (product.specs && product.specs.length) { %>
          <h2 class="mt-3">Key specs</h2>
          <div class="table-wrap">
            <table class="table">
              <caption class="visually-hidden">Product specifications</caption>
              <tbody>
                <% product.specs.forEach(function (spec) { %>
                  <tr>
                    <th scope="row"><%= Array.isArray(spec) ? spec[0] : spec.label %></th>
                    <td><%= Array.isArray(spec) ? spec[1] : spec.value %></td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        <% } %>

        <% if (product.description) { %>
          <div class="post-body mt-3">
            <p><%= product.description %></p>
          </div>
        <% } %>

        <p class="field__hint mt-2">
          Not sure this fits your car? <a href="/contact">Ask us first</a> — a two-line message saves a
          return. For a part rather than an accessory, use <a href="/services/parts">parts sourcing</a>.
        </p>
      </div>
    </div>
  </div>
</section>

<% if (related.length) { %>
<section class="section section--surface">
  <div class="container">
    <div class="section-head">
      <h2>Also in <%= product.categoryLabel.toLowerCase() %></h2>
      <a class="section-head__link" href="/shop?category=<%= product.category %>">See the category →</a>
    </div>
    <div class="product-grid">
      <% related.forEach(function (item) { %>
        <%- include('../partials/product-card', { product: item, helpers: helpers }) %>
      <% }); %>
    </div>
  </div>
</section>
<% } %>

<% if (faqs.length) { %>
<section class="section">
  <div class="container container--narrow">
    <div class="section-head"><h2><%= product.categoryLabel %> — questions</h2></div>
    <%- include('../partials/accordion', { faqs: faqs, idPrefix: 'product-faq' }) %>
  </div>
</section>
<% } %>
