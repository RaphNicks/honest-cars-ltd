<%#
  /login — customer email OTP or Google sign-in; legacy customers and staff may
  use the existing phone OTP path. Staff continue through phone + TOTP.
  Locals: next, reason, ref, save, authErrorMessage, googleReady, otp
%>
<section class="page-hero">
  <div class="container container--narrow">
    <% if (trail) { %><%- include('../partials/breadcrumbs', { crumbs: trail }) %><% } %>
    <p class="eyebrow">Account</p>
    <h1>Sign in or create your account</h1>
    <p class="lead">
      Use your email and a one-time code, or continue with Google. You do not need a phone number to open an account.
    </p>
  </div>
</section>

<section class="section">
  <div class="container container--narrow">
    <% if (reason === 'expired') { %>
      <p class="auth-message auth-message--banner" data-state="error">
        Your session ended, so we asked you to sign in again. Nothing was lost.
      </p>
    <% } %>
    <% if (authErrorMessage) { %>
      <p class="auth-message auth-message--banner" data-state="error"><%= authErrorMessage %></p>
    <% } %>

    <div class="auth-card" data-auth-card data-next="<%= next %>" data-ref="<%= ref %>" data-save="<%= save || '' %>">
      <div class="btn-row" role="group" aria-label="Choose a sign-in method">
        <button class="btn btn--secondary" type="button" data-auth-mode="email" aria-pressed="true">Email or Google</button>
        <button class="btn btn--ghost" type="button" data-auth-mode="phone" aria-pressed="false">Existing phone account or staff</button>
      </div>

      <div data-auth-panel="email">
        <form class="auth-form mt-3" data-auth-step="email" action="/api/auth/email/otp" method="post" novalidate>
          <h2 class="mb-1">Your details</h2>
          <p class="note-inline">New here? We will create your customer account after you verify your email. Returning customers can use the same code sign-in.</p>

          <% if (ref) { %>
            <p class="note-inline">
              Invitation code <strong class="tabular"><%= ref %></strong> — it is recorded on your account when you sign in for the first time.
            </p>
          <% } %>

          <div class="field">
            <label class="field__label" for="login-name">Your name</label>
            <input class="input" id="login-name" name="name" type="text" autocomplete="name" minlength="2" maxlength="120" placeholder="Ada Obi" required>
          </div>
          <div class="field">
            <label class="field__label" for="login-email">Email address</label>
            <input class="input" id="login-email" name="email" type="email" inputmode="email" autocomplete="email" maxlength="160" placeholder="you@example.com" required>
            <p class="field__hint">We will send a one-time code to this address. No phone number or password needed. <a href="/privacy">Privacy</a>.</p>
          </div>

          <input type="hidden" name="ref" value="<%= ref %>">
          <input type="hidden" name="next" value="<%= next %>">
          <div class="btn-row">
            <button class="btn btn--primary" type="submit">Send my email code</button>
            <a class="btn btn--secondary" href="/api/auth/google?next=<%= encodeURIComponent(next || '/account') %><%= save ? '&save=' + encodeURIComponent(save) : '' %>">Continue with Google</a>
          </div>
          <% if (!googleReady) { %>
            <p class="field__hint">Google sign-in will work once its OAuth credentials are added to the hosting settings.</p>
          <% } %>
          <p class="auth-message" data-auth-message role="status" aria-live="polite"></p>
        </form>

        <form class="auth-form hidden" data-auth-step="email-code" action="/api/auth/email/verify" method="post" novalidate hidden>
          <h2 class="mb-1">Check your email</h2>
          <p class="note-inline">We sent a one-time code to <strong data-auth-email>your email</strong>. It expires in <%= otp.ttlMinutes %> minutes.</p>
          <input type="hidden" name="email">
          <input type="hidden" name="name">
          <input type="hidden" name="ref" value="<%= ref %>">
          <input type="hidden" name="next" value="<%= next %>">
          <div class="field">
            <label class="field__label" for="login-email-code">Email code</label>
            <input class="input input--code tabular" id="login-email-code" name="code" type="text" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]*" maxlength="<%= otp.length %>" placeholder="<%= '0'.repeat(otp.length) %>" required>
          </div>
          <div class="btn-row">
            <button class="btn btn--primary" type="submit">Sign in</button>
            <button class="btn btn--ghost" type="button" data-auth-restart>Use a different email</button>
            <button class="btn btn--secondary" type="button" data-auth-resend>Send a new code</button>
          </div>
          <p class="auth-message" data-auth-message role="status" aria-live="polite"></p>
        </form>
      </div>

      <div data-auth-panel="phone" class="hidden" hidden>
        <form class="auth-form mt-3" data-auth-step="phone" action="/api/auth/otp" method="post" novalidate>
          <h2 class="mb-1">Existing phone account or staff</h2>
          <p class="note-inline">Use the phone number already linked to your account. Staff continue with their authenticator code after this step.</p>
          <div class="field">
            <label class="field__label" for="login-phone">Phone number</label>
            <input class="input" id="login-phone" name="phone" type="tel" inputmode="tel" autocomplete="tel" placeholder="0803 123 4567" required aria-describedby="login-phone-hint">
            <p class="field__hint" id="login-phone-hint">Any format works — <span class="tabular">0803 123 4567</span> or <span class="tabular">+234 803 123 4567</span>.</p>
          </div>
          <label class="checkbox-row">
            <input type="checkbox" name="consent" value="1" checked>
            <span>I agree to Honest Cars contacting me on this number about my requests and orders.</span>
          </label>
          <input type="hidden" name="next" value="<%= next %>">
          <input type="hidden" name="ref" value="<%= ref %>">
          <div class="btn-row">
            <button class="btn btn--primary" type="submit">Send my phone code</button>
            <a class="btn btn--ghost" href="<%= otp.whatsappLink %>" target="_blank" rel="noopener" data-event="whatsapp_click" data-source="login">Code not arriving? WhatsApp us</a>
          </div>
          <p class="auth-message" data-auth-message role="status" aria-live="polite"></p>
        </form>

        <form class="auth-form hidden" data-auth-step="phone-code" action="/api/auth/verify" method="post" novalidate hidden>
          <h2 class="mb-1">Enter your phone code</h2>
          <p class="note-inline">We sent a <%= otp.length %>-digit code to <strong data-auth-phone>your number</strong>.</p>
          <input type="hidden" name="phone">
          <input type="hidden" name="next" value="<%= next %>">
          <input type="hidden" name="ref" value="<%= ref %>">
          <div class="field">
            <label class="field__label" for="login-code">Login code</label>
            <input class="input input--code tabular" id="login-code" name="code" type="text" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]*" maxlength="<%= otp.length %>" placeholder="<%= '0'.repeat(otp.length) %>" required>
          </div>
          <div class="btn-row">
            <button class="btn btn--primary" type="submit">Sign in</button>
            <button class="btn btn--ghost" type="button" data-auth-restart>Use a different number</button>
            <button class="btn btn--secondary" type="button" data-auth-resend>Send a new code</button>
          </div>
          <p class="auth-message" data-auth-message role="status" aria-live="polite"></p>
        </form>
        <% if (otp.provider === 'console') { %>
          <p class="auth-devnote">
            <strong>Development:</strong> no phone OTP provider is configured, so the code appears in the development response and server log. Staff still need their authenticator code after phone verification.
          </p>
        <% } %>
      </div>

      <% if (!mailReady && development) { %>
        <p class="auth-devnote">
          <strong>Development:</strong> SMTP is not configured. Email codes appear in the development response and server log. Set <code>SMTP_URL</code> and <code>SMTP_FROM</code> for delivery.
        </p>
      <% } else if (!mailReady) { %>
        <p class="auth-devnote">
          Email sign-in is temporarily unavailable until email delivery is configured. Existing phone-account customers and staff can use the phone sign-in option.
        </p>
      <% } %>
    </div>

    <div class="grid grid--3 mt-4">
      <div class="card card__body">
        <h3 class="mb-1">Requests</h3>
        <p class="mb-0">Keep track of your concierge, sell, swap, parts and hire requests.</p>
      </div>
      <div class="card card__body">
        <h3 class="mb-1">Bookings &amp; orders</h3>
        <p class="mb-0">See your inspections, installations, shop orders and tracker subscriptions.</p>
      </div>
      <div class="card card__body">
        <h3 class="mb-1">Saved cars &amp; searches</h3>
        <p class="mb-0">Shortlist cars and save a search to pick up later.</p>
      </div>
    </div>
  </div>
</section>
