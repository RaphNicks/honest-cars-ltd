<%# Blog card — “From the Blog” homepage module 8 (§6.1) and /blog grid (§6.9) %>
<article class="post-card">
  <div class="post-card__media">
    <img class="post-card__img" src="<%= post.heroImage %>" alt="<%= helpers.esc(post.heroAlt) %>"
         width="1200" height="675" loading="lazy" decoding="async">
  </div>
  <div class="post-card__body">
    <span class="badge badge--ghost"><%= post.categoryLabel %></span>
    <h3 class="post-card__title"><a href="<%= post.url %>"><%= post.title %></a></h3>
    <p class="post-card__excerpt"><%= post.excerpt %></p>
    <p class="post-card__meta mb-0"><%= post.readMinutes %> min read · <%= post.author.name %></p>
  </div>
</article>
