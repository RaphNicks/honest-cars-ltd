<%# §5.2 mobile: hamburger opens a full-height drawer with an accordion Services. %>
<div class="drawer" id="mobile-drawer" data-open="false" role="dialog" aria-modal="true" aria-label="Menu">
  <div class="drawer__head">
    <a class="header__logo" href="/" tabindex="-1">
      <%- helpers.icon('shield', { size: 28, className: 'header__logo-mark' }) %>
      <span>Honest<em>Cars</em></span>
    </a>
    <button class="icon-btn" type="button" aria-label="Close menu" data-drawer-close>
      <%- helpers.icon('close', { size: 24 }) %>
    </button>
  </div>

  <div class="drawer__body">
    <a class="drawer__link" href="/cars">Buy Cars</a>

    <details class="drawer__group">
      <summary>Services <%- helpers.icon('chevronDown', { size: 20 }) %></summary>
      <% site.services.forEach(function (service) { %>
        <a class="drawer__sublink" href="/services/<%= service.slug %>"><%= service.name %></a>
      <% }); %>
    </details>

    <a class="drawer__link" href="/sell-swap">Sell/Swap</a>
    <a class="drawer__link" href="/hire">Hire</a>
    <a class="drawer__link" href="/blog">Blog</a>
    <a class="drawer__link" href="/guide">Honest Buyer’s Guide</a>
    <a class="drawer__link" href="/how-it-works">How it works</a>
    <a class="drawer__link" href="/verification">Verification</a>
    <a class="drawer__link" href="/about">About</a>
    <a class="drawer__link" href="/faq">FAQ</a>
    <a class="drawer__link" href="/contact">Contact</a>
    <a class="drawer__link" href="/account">Account</a>
  </div>

  <div class="drawer__foot">
    <a class="btn btn--primary btn--block" href="/find-my-car">Find My Car</a>
    <a class="btn btn--secondary btn--block mt-1" href="<%= site.nav.whatsapp.general %>" data-event="whatsapp_click" data-source="drawer">
      <%- helpers.icon('whatsapp', { size: 20 }) %> Chat on WhatsApp
    </a>
  </div>
</div>
