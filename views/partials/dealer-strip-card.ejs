<%#
  Dealer storefront strip card (§037) — a compact, horizontally-scrolling tile
  for the lot's "Deals" (live cars below the market band) and "Recently sold"
  strips. Locals: car (a compact listing: id, title, priceKobo, url, image,
  soldInDays), helpers, badge (the label text), [sold] (grey it out).
%>
<a class="dealer-strip-card<%= sold ? ' dealer-strip-card--sold' : '' %>" href="<%= car.url %>">
  <div class="dealer-strip-card__media media-blur"
       <% var blur = car.image ? helpers.blurFor(car.image) : null; %><% if (blur) { %>style="background-image:url('<%= blur %>')"<% } %>>
    <% if (car.image) { %>
      <img src="<%= helpers.photoSrc(car.image) %>" alt="<%= car.title %>"
           width="600" height="400" loading="lazy" decoding="async">
    <% } else { %>
      <div class="placeholder-media" aria-hidden="true"></div>
    <% } %>
  </div>
  <div class="dealer-strip-card__body">
    <h3 class="dealer-strip-card__title"><%= car.title %></h3>
    <p class="dealer-strip-card__price mb-0"><%= helpers.formatNaira(car.priceKobo) %></p>
  </div>
  <span class="dealer-strip-card__badge"><%= badge %></span>
</a>
