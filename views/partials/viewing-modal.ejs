<%#
  §6.3 “Request Viewing” — a 3-field modal (name, phone, preferred day) that
  creates a lead and pings the ops WhatsApp queue. No account required
  (guest-first; the account is offered only after the action).
  Locals: listing
%>
<div class="modal" id="viewing-modal" data-open="false" data-listing-id="<%= listing.id %>"
     role="dialog" aria-modal="true" aria-labelledby="viewing-modal-title" hidden>
  <div class="modal__scrim" data-modal-close></div>
  <div class="modal__panel">
    <button class="modal__close" type="button" aria-label="Close" data-modal-close>
      <%- helpers.icon('close', { size: 22 }) %>
    </button>

    <h2 id="viewing-modal-title">Request a viewing</h2>
    <p class="note-inline"><%= listing.title %> · <%= helpers.formatNaira(listing.priceKobo) %> · <%= listing.area %></p>

    <form data-lead-form data-lead-type="viewing" data-listing-id="<%= listing.id %>"
            data-draft="viewing-<%= listing.id %>" novalidate>
      <div class="field">
        <label class="field__label" for="viewing-name">Your name</label>
        <input class="input" id="viewing-name" name="name" type="text" autocomplete="name" required>
      </div>

      <div class="field">
        <label class="field__label" for="viewing-phone">WhatsApp number</label>
        <input class="input" id="viewing-phone" name="phone" type="tel" inputmode="numeric"
               autocomplete="tel" placeholder="080 0000 0000" required>
        <span class="field__hint">We confirm by WhatsApp — no calls unless you ask.</span>
      </div>

      <div class="field">
        <label class="field__label" for="viewing-day">Preferred day</label>
        <input class="input" id="viewing-day" name="preferred_day" type="date">
      </div>

      <p class="field__hint">No account needed. We only use your number to arrange this viewing.</p>

      <button class="btn btn--primary btn--block" type="submit" data-submit>Request viewing</button>
      <p class="field__error hidden mt-1" data-form-error role="alert"></p>
    </form>

    <div class="hidden" data-lead-success>
      <p class="mb-0"><strong>Viewing requested.</strong></p>
      <p class="note-inline">Our ops team will confirm on WhatsApp shortly. You can also message us now:</p>
      <a class="btn btn--secondary btn--block" target="_blank" rel="noopener"
         href="<%= helpers.whatsappLink('Hi HonestCars, I just requested a viewing for ' + listing.title + ' (' + listing.stockNo + ').', 'viewing_modal:' + listing.stockNo) %>"
         data-event="whatsapp_click" data-source="viewing_modal">
        <%- helpers.icon('whatsapp', { size: 20 }) %> Chat on WhatsApp
      </a>
    </div>
  </div>
</div>
